# Copy to .env.local for local development. In production set these in Vercel.

# giltsyield.com personal API key (Profile page). Enables intraday gilt prices and the Portfolio page.
GILTSYIELD_API_KEY=

# Anthropic API key. Optional: enables "Summarise for gilts" in the News reader
# (about 1p per summary, only when you click the button).
ANTHROPIC_API_KEY=

# Password for the whole site (any username). Strongly recommended in production.
DASHBOARD_PASSWORD=

# Optional overrides
# DATA_DIR=data-demo          # use synthetic data from `npm run demo-data`
# GILTSYIELD_BASE_URL=https://giltsyield.com
# DMO_PRICES_URL=             # if the DMO reference-price report URL changes
# DMO_IN_ISSUE_URL=
# BOE_LATEST_URL=
# KEEP_YEARS=5                # history retained in data/curves
# LIVE_CACHE_SECONDS=300      # how long intraday prices are reused before re-fetching
# NEWS_SUMMARIES=off           # hide the summary button even with a key set
# LIVE_PRICES=off             # disable intraday prices but keep the Portfolio page
